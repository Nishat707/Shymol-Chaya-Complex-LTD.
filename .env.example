# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Local Supabase database connection strings for development.
# Vercel should use the existing Prisma Postgres production connection URL for DATABASE_URL instead.
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
# First Super Admin (must be an email account you control)
SUPER_ADMIN_EMAIL=you@example.com
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
